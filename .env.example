# Copy locally to .env; preserve your existing .env when upgrading.
AQUACULTURE_HOST=0.0.0.0
AQUACULTURE_PORT=5000
AQUACULTURE_DEBUG=0
AQUACULTURE_SECRET_KEY=
AQUACULTURE_CAMERA_AUTOSTART=0
AQUACULTURE_SERIAL_PORT=
AQUACULTURE_SERIAL_BAUDRATE=115200
# Legacy local network panel is optional, independent of the new BLE service.
AQUACULTURE_NETWORK_PANEL=0
AQUACULTURE_BLE_ENABLED=0
# New BLE service: systemd environment override, not loaded from the Flask .env.
# AQUACULTURE_WIFI_INTERFACE=wlan0
EMAIL_USER=
EMAIL_APP_PASSWORD=
UNISMS_URL=
# Main AquaCulture backend origin (HTTPS, no path). Never use the static Vercel
# setup origin here unless that origin actually serves the Flask reset endpoints.
AQUACULTURE_PUBLIC_ORIGIN=
# Optional initial association. Thereafter manage it in Settings > Access.
AQUACULTURE_ADMIN_EMAIL=
# Optional shared credential-store override. Linux uses /var/lib/aquaculture-auth/
# after the Pi installer; Windows defaults to database/admin_auth.sqlite3.
# AQUACULTURE_AUTH_DB=
