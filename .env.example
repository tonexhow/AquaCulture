# Copy locally to .env; preserve your existing .env when upgrading.
AQUACULTURE_HOST=0.0.0.0
AQUACULTURE_PORT=5000
AQUACULTURE_DEBUG=0
AQUACULTURE_SECRET_KEY=
AQUACULTURE_CAMERA_AUTOSTART=0
# Selection defaults to auto: validated CSI first, then actual USB capture nodes.
# csi and usb force that source. Picamera2 is optional for USB/laptop operation.
AQUACULTURE_CAMERA_SOURCE=auto
# Optional stable path, e.g. /dev/v4l/by-id/usb-...-video-index0
AQUACULTURE_CAMERA_USB_DEVICE=
AQUACULTURE_CAMERA_WIDTH=1280
AQUACULTURE_CAMERA_HEIGHT=720
AQUACULTURE_CAMERA_FPS=15
AQUACULTURE_CAMERA_RETRY_SECONDS=5
AQUACULTURE_CAMERA_FRAME_TIMEOUT=4
# Native OpenCV V4L2 select timeout is seconds; set before OpenCV starts.
OPENCV_VIDEOIO_V4L_SELECT_TIMEOUT=3
AQUACULTURE_SERIAL_PORT=
AQUACULTURE_SERIAL_BAUDRATE=115200
# Legacy local network panel is optional, independent of the new BLE service.
AQUACULTURE_NETWORK_PANEL=0
AQUACULTURE_BLE_ENABLED=0
# New BLE service: systemd environment override, not loaded from the Flask .env.
# AQUACULTURE_WIFI_INTERFACE=wlan0
EMAIL_USER=
EMAIL_APP_PASSWORD=
UNISMS_URL=
# Main AquaCulture backend origin (HTTPS, no path). Never use the static Vercel
# setup origin here unless that origin actually serves the Flask reset endpoints.
AQUACULTURE_PUBLIC_ORIGIN=
# Optional initial association. Thereafter manage it in Settings > Access.
AQUACULTURE_ADMIN_EMAIL=
# Optional shared credential-store override. Linux uses /var/lib/aquaculture-auth/
# after the Pi installer; Windows defaults to database/admin_auth.sqlite3.
# AQUACULTURE_AUTH_DB=

# Visual scan: 3/5/10 seconds controls camera capture ONLY.
# AI runs afterward in a background job and can take minutes on Pi 4B.
# Maximum seconds for ALL selected frames, 120-900 permitted.
# If unset: max(120, selected_frames * 60), capped at 900.
# AQUACULTURE_VISUAL_PROCESS_TIMEOUT=600
# Maximum seconds per isolated NCNN worker invocation (default 300).
# AQUACULTURE_ML_TIMEOUT=300
# NCNN inference size, not camera video resolution (default 640).
# AQUACULTURE_MARINE_NCNN_IMGSZ=640
